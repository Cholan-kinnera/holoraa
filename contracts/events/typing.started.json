{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holoraa.app/schemas/events/typing.started.v1.json",
  "title": "TypingStartedEvent",
  "description": "Realtime notification broadcast when a user begins typing in an active conversation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "timestamp", "payload"],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "const": "typing.started"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "userId"],
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
