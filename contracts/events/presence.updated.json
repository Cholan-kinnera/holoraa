{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holoraa.app/schemas/events/presence.updated.v1.json",
  "title": "PresenceUpdatedEvent",
  "description": "Realtime notification broadcast when an active contact's connection state transitions between online and offline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "timestamp", "payload"],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "const": "presence.updated"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "status", "lastSeenAt"],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": ["online", "offline"]
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
