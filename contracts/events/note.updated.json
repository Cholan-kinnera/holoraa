{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holoraa.app/schemas/events/note.updated.v1.json",
  "title": "NoteUpdatedEvent",
  "description": "Realtime notification broadcast when a user sets or clears their 24-hour status note. Transport: Server-to-client over authenticated WebSocket. Visibility: Followed connections and active orbit contacts only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "id", "data"],
  "properties": {
    "type": {
      "type": "string",
      "const": "note.updated"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier (UUIDv7)."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "text", "expiresAt", "updatedAt"],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "text": {
          "type": ["string", "null"],
          "maxLength": 60,
          "description": "The active note text, or null if cleared."
        },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Timestamp when the note expires, or null if cleared."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
