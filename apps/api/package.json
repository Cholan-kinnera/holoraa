{
  "name": "@holoraa/api",
  "version": "0.0.0",
  "private": true,
  "description": "Holoraa API server — NestJS, REST + WebSocket gateway.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@holoraa/shared": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/platform-socket.io": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.2.0",
    "@prisma/client": "7.10.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pino-http": "10.6.0",
    "pino-pretty": "13.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@holoraa/config": "workspace:*",
    "@nestjs/cli": "12.0.4",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.3",
    "@types/node": "22.16.1",
    "eslint": "10.13.0",
    "prisma": "7.10.1",
    "supertest": "7.1.0",
    "@types/supertest": "6.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
