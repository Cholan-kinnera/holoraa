# Copy to .env with `scripts/dev-env.sh`. Do not commit .env.
# Values are generated per developer. Keys only are documented here.

# Local development database password (generated).
HOLORAA_DEV_DB_PASSWORD=

# Host port for the development database, bound to 127.0.0.1.
HOLORAA_DEV_DB_PORT=5433

# Connection string used by the backend and migrations (generated).
HOLORAA_DATABASE_URL=

# HTTP listen address for the API.
HOLORAA_HTTP_ADDR=127.0.0.1:8080

# Log level: debug, info, warn, error.
HOLORAA_LOG_LEVEL=info

# Base URL the web app uses to reach the API (server side).
HOLORAA_API_URL=http://127.0.0.1:8080
