# Copy to .env with `scripts/dev-env.sh`. Do not commit .env.
# Values are generated per developer. Keys only are documented here.

# Local development database password (generated).
HOLORAA_DEV_DB_PASSWORD=

# Host port for the development database, bound to 127.0.0.1.
HOLORAA_DEV_DB_PORT=5433

# Connection string used by the backend and migrations (generated).
HOLORAA_DATABASE_URL=

# HTTP listen address for the API.
HOLORAA_HTTP_ADDR=127.0.0.1:8080

# Log level: debug, info, warn, error.
HOLORAA_LOG_LEVEL=info

# Base URL the web app uses to reach the API (server side).
HOLORAA_API_URL=http://127.0.0.1:8080

# Auth secret: HMAC key for sign-in codes and CSRF tokens, at least 32
# characters. Generated by scripts/dev-env.sh. Never commit a real value.
HOLORAA_AUTH_SECRET=

# Origins allowed to make state-changing requests, comma-separated.
HOLORAA_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Session cookie security. Production keeps true (the __Host- cookie).
# Local development over plain HTTP sets false, which uses the holoraa_session name.
HOLORAA_COOKIE_SECURE=false

# Email provider: fake writes codes to a local outbox (development default).
# resend needs HOLORAA_MAIL_FROM and HOLORAA_RESEND_API_KEY, set by the owner.
HOLORAA_MAIL_PROVIDER=fake
HOLORAA_MAIL_OUTBOX_DIR=.local/mail
