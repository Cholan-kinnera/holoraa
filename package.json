{
  "name": "holoraa",
  "version": "0.0.0",
  "private": true,
  "description": "One simple, safe place to talk, share and hang out with the people who matter to you.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "db:migrate": "pnpm --filter @holoraa/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @holoraa/api exec prisma db seed",
    "db:reset": "pnpm --filter @holoraa/api exec prisma migrate reset --force",
    "db:generate": "pnpm --filter @holoraa/api exec prisma generate",
    "db:studio": "pnpm --filter @holoraa/api exec prisma studio",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  }
}
